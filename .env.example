# ============================================================
#  wa-edu-bot — environment configuration
#  Copy this file to ".env" and fill what you have.
#  EVERYTHING is optional: with no creds the bot runs in STUB
#  mode (it logs what it WOULD send) so you can test locally.
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
# Public HTTPS URL Meta/Razorpay can reach (use ngrok for local: https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=

# ---- WhatsApp Cloud API (Meta) ----
# From Meta App Dashboard -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# You invent this string; paste the SAME value into Meta webhook config
WA_VERIFY_TOKEN=change-me-verify-token
# App secret (App Dashboard -> Settings -> Basic) -> validates webhook signatures
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
WA_BUSINESS_ACCOUNT_ID=

# ---- Google Gemini ----
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Database (SQLite; swap to Postgres later by changing provider + this URL) ----
DATABASE_URL="file:./dev.db"

# ---- Institute config ----
INSTITUTE_NAME=Pratham Academy
TIMEZONE=Asia/Kolkata
# Cron schedules (in TIMEZONE above)
DAILY_MCQ_CRON=0 7 * * *
WEEKLY_LEADERBOARD_CRON=0 8 * * 1
REENGAGE_CRON=0 10 * * *
REENGAGE_AFTER_DAYS=7

# ---- Approved WhatsApp template names (needed for proactive sends outside 24h window) ----
TPL_DAILY_MCQ=daily_mcq
TPL_REENGAGE=reengage_v1
TPL_RESULT=result_felicitation
TPL_LANG=en

# ---- Razorpay (payment links) ----
# Dashboard -> Settings -> API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks (separate secret)
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Calendar (demo booking) ----
# Create a service account, share your calendar with its email ("Make changes to events")
GCAL_CALENDAR_ID=primary
GCAL_SA_EMAIL=
# Paste the private_key from the service-account JSON (keep the \n escapes)
GCAL_SA_PRIVATE_KEY=
GCAL_SEND_MEET_LINK=true

# ---- Logging ----
LOG_LEVEL=info

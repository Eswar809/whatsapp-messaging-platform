# ============================================================
#  wa-edu-bot — PRODUCTION environment configuration
#  Copy to ".env" on your host (or set these as platform secrets)
#  and fill in real values. Unlike local/stub mode, production
#  needs real WhatsApp + Gemini + (optionally) Razorpay/Calendar creds.
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
# STABLE public HTTPS URL Meta/Razorpay can reach.
# Use your platform domain (e.g. https://pratham-bot.up.railway.app)
# or a custom domain. NOT an ephemeral cloudflare/ngrok tunnel.
PUBLIC_BASE_URL=https://api.yourdomain.com

# ---- WhatsApp Cloud API (Meta) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# You invent this string; paste the SAME value into Meta webhook config
WA_VERIFY_TOKEN=change-me-verify-token
# App secret (App Dashboard -> Settings -> Basic) -> validates webhook signatures
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
WA_BUSINESS_ACCOUNT_ID=

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Database (Postgres in production) ----
# Example Postgres URL. Most platforms inject this automatically (Railway/Render).
# Remember to also set provider = "postgresql" in prisma/schema.prisma.
DATABASE_URL=postgresql://user:pass@host:5432/db

# ---- Institute config ----
INSTITUTE_NAME=Pratham Academy
TIMEZONE=Asia/Kolkata
# Cron schedules (in TIMEZONE above) — require an always-on host
DAILY_MCQ_CRON=0 7 * * *
WEEKLY_LEADERBOARD_CRON=0 8 * * 1
REENGAGE_CRON=0 10 * * *
REENGAGE_AFTER_DAYS=7

# ---- Approved WhatsApp template names (needed for proactive sends outside 24h window) ----
TPL_DAILY_MCQ=daily_mcq
TPL_REENGAGE=reengage_v1
TPL_RESULT=result_felicitation
TPL_LANG=en

# ---- Razorpay (payment links) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Calendar (demo booking) ----
GCAL_CALENDAR_ID=primary
GCAL_SA_EMAIL=
# Paste the private_key from the service-account JSON (keep the \n escapes)
GCAL_SA_PRIVATE_KEY=
GCAL_SEND_MEET_LINK=true

# ---- Logging ----
LOG_LEVEL=info
